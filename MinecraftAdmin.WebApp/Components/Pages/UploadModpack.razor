@page "/modpacks/upload"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Diagnostics
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Upload Modpack</PageTitle>

<div class="app-page upload-modpack-page">
    <div class="page-heading">
        <div>
            <h1>Upload Modpack</h1>
            <p class="hint">Add a reusable server pack to the modpack library.</p>
        </div>
        <button @onclick="Back" disabled="@uploading_">Back</button>
    </div>

    <section class="panel upload-panel">
        <label for="name">Name</label>
        <input id="name"
               type="text"
               placeholder="Create Astral"
               @bind="name_"
               disabled="@uploading_" />

        <label for="environment">Minecraft environment</label>
        <p class="hint">
            Enter the environment variables specific to this pack, e.g. forge version.
        </p>
        <textarea id="environment"
                  spellcheck="false"
                  placeholder=@($"TYPE=FABRIC{Environment.NewLine}VERSION=1.18.2{Environment.NewLine}FABRIC_LOADER_VERSION=0.18.4")
                  @bind="environment_"
                  disabled="@uploading_"></textarea>

        <label for="server-pack">Server pack ZIP</label>
        <input id="server-pack"
               @ref="fileInput_"
               type="file"
               accept=".zip,application/zip"
               @onchange="OnFileSelectedAsync"
               disabled="@uploading_" />

        @if (selectedFile_ is not null)
        {
            <div class="file-summary">
                <strong>@selectedFile_.Name</strong>
                <span>@FormatBytes(selectedFile_.Size)</span>
            </div>
        }

        @if (uploading_)
        {
            <div class="upload-progress" aria-live="polite">
                <div class="progress-heading">
                    <span>@UploadPercent.ToString("0.0")%</span>
                    <span>@FormatBytes(uploadTransferred_) / @FormatBytes(uploadTotal_)</span>
                </div>
                <div class="progress-track"
                     role="progressbar"
                     aria-label="Modpack upload progress"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="@UploadPercentAria">
                    <div class="progress-fill" style="@UploadProgressStyle"></div>
                </div>
                <div class="progress-timing">@UploadTimingText</div>
            </div>
        }

        <div class="upload-actions">
            <button @onclick="UploadAsync" disabled="@(uploading_ || selectedFile_ is null)">
                @if (uploading_ && !cancelling_)
                {
                    <span class="spinner" aria-hidden="true"></span>
                    <span>Uploading…</span>
                }
                else
                {
                    <span>Upload</span>
                }
            </button>

            @if (uploading_)
            {
                <button class="cancel-button" @onclick="CancelUploadAsync" disabled="@cancelling_">
                    @if (cancelling_)
                    {
                        <span class="spinner" aria-hidden="true"></span>
                        <span>Cancelling…</span>
                    }
                    else
                    {
                        <span>Cancel</span>
                    }
                </button>
            }
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(status_))
    {
        <p class="status-message">@status_</p>
    }

    @if (!string.IsNullOrWhiteSpace(error_))
    {
        <div class="error">@error_</div>
    }
</div>

@code {
    private sealed record BrowserFileInfo(string Name, long Size);

    private string name_ = string.Empty;
    private string environment_ = string.Empty;
    private BrowserFileInfo? selectedFile_;
    private ElementReference fileInput_;
    private DotNetObjectReference<UploadModpack>? dotNetReference_;
    private string? uploadId_;
    private bool uploading_;
    private bool cancelling_;
    private string? status_;
    private string? error_;
    private long uploadTransferred_;
    private long uploadTotal_;
    private readonly Stopwatch uploadStopwatch_ = new();

    private double UploadPercent => uploadTotal_ <= 0
        ? 0
        : Math.Clamp((double)uploadTransferred_ / uploadTotal_ * 100.0, 0, 100);

    private string UploadPercentAria => UploadPercent.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
    private string UploadProgressStyle => $"width: {UploadPercent.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)}%;";

    private string UploadTimingText
    {
        get
        {
            if (uploadTransferred_ >= uploadTotal_ && uploadTotal_ > 0)
                return "Upload sent. Validating and saving modpack…";

            var elapsed = uploadStopwatch_.Elapsed;
            if (uploadTransferred_ <= 0 || elapsed.TotalSeconds <= 0.1)
                return $"Elapsed {FormatDuration(elapsed)}";

            var bytesPerSecond = uploadTransferred_ / elapsed.TotalSeconds;
            if (bytesPerSecond > 0)
            {
                var remaining = TimeSpan.FromSeconds((uploadTotal_ - uploadTransferred_) / bytesPerSecond);
                return $"{FormatRate(bytesPerSecond)} · Elapsed {FormatDuration(elapsed)} · About {FormatDuration(remaining)} remaining";
            }

            return $"Elapsed {FormatDuration(elapsed)}";
        }
    }

    private async Task OnFileSelectedAsync()
    {
        selectedFile_ = await JS.InvokeAsync<BrowserFileInfo?>("modpackUpload.getFileInfo", fileInput_);
        uploadTransferred_ = 0;
        uploadTotal_ = selectedFile_?.Size ?? 0;
        uploadStopwatch_.Reset();
        error_ = null;
        status_ = null;
    }

    private async Task UploadAsync()
    {
        if (uploading_ || selectedFile_ is null)
            return;

        uploading_ = true;
        cancelling_ = false;
        uploadTransferred_ = 0;
        uploadTotal_ = selectedFile_.Size;
        uploadStopwatch_.Restart();
        error_ = null;
        status_ = "Uploading server pack…";
        uploadId_ = Guid.NewGuid().ToString("N");
        dotNetReference_ ??= DotNetObjectReference.Create(this);

        try
        {
            await JS.InvokeVoidAsync(
                "modpackUpload.start",
                uploadId_,
                fileInput_,
                name_,
                environment_,
                dotNetReference_);
        }
        catch (Exception ex)
        {
            uploadStopwatch_.Stop();
            uploading_ = false;
            uploadId_ = null;
            error_ = ex.Message;
            status_ = null;
        }
    }

    private async Task CancelUploadAsync()
    {
        if (!uploading_ || string.IsNullOrWhiteSpace(uploadId_) || cancelling_)
            return;

        cancelling_ = true;
        status_ = "Cancelling upload…";

        try
        {
            await JS.InvokeVoidAsync("modpackUpload.cancel", uploadId_, true);
        }
        catch (Exception ex)
        {
            cancelling_ = false;
            error_ = ex.Message;
        }
    }

    [JSInvokable]
    public Task OnUploadProgress(long bytesTransferred, long totalBytes)
    {
        uploadTransferred_ = bytesTransferred;
        uploadTotal_ = totalBytes;
        status_ = uploadTransferred_ >= uploadTotal_ && uploadTotal_ > 0
            ? "Upload sent. Validating and saving modpack…"
            : "Uploading server pack…";

        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnUploadCompleted(int statusCode, string responseText)
    {
        uploadStopwatch_.Stop();
        uploading_ = false;
        cancelling_ = false;
        uploadId_ = null;

        if (statusCode is >= 200 and < 300)
        {
            Navigation.NavigateTo("/modpacks");
            return Task.CompletedTask;
        }

        error_ = GetErrorMessage(responseText, $"Upload failed with HTTP {statusCode}.");
        status_ = null;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnUploadFailed(string message)
    {
        uploadStopwatch_.Stop();
        uploading_ = false;
        cancelling_ = false;
        uploadId_ = null;
        error_ = message;
        status_ = null;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnUploadCancelled()
    {
        uploadStopwatch_.Stop();
        uploading_ = false;
        cancelling_ = false;
        uploadId_ = null;
        uploadTransferred_ = 0;
        status_ = "Upload cancelled.";
        error_ = null;
        return InvokeAsync(StateHasChanged);
    }

    private void Back() => Navigation.NavigateTo("/modpacks");

    public async ValueTask DisposeAsync()
    {
        if (!string.IsNullOrWhiteSpace(uploadId_))
        {
            try
            {
                await JS.InvokeVoidAsync("modpackUpload.cancel", uploadId_, false);
            }
            catch (JSDisconnectedException)
            {
            }
        }

        dotNetReference_?.Dispose();
    }

    private static string GetErrorMessage(string responseText, string fallback)
    {
        if (string.IsNullOrWhiteSpace(responseText))
            return fallback;

        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(responseText);
            if (document.RootElement.TryGetProperty("error", out var error) && error.ValueKind == System.Text.Json.JsonValueKind.String)
                return error.GetString() ?? fallback;
        }
        catch (System.Text.Json.JsonException)
        {
        }

        return fallback;
    }

    private static string FormatBytes(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        var value = (double)bytes;
        var unit = 0;
        while (value >= 1024 && unit < units.Length - 1)
        {
            value /= 1024;
            unit++;
        }
        return $"{value:0.##} {units[unit]}";
    }

    private static string FormatRate(double bytesPerSecond) => $"{FormatBytes((long)bytesPerSecond)}/s";

    private static string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalHours >= 1)
            return $"{(int)duration.TotalHours}:{duration.Minutes:00}:{duration.Seconds:00}";

        return $"{(int)duration.TotalMinutes}:{duration.Seconds:00}";
    }
}
