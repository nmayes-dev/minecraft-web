@page "/"
@rendermode InteractiveServer
@inject MinecraftService Minecraft

<PageTitle>Minecraft Admin</PageTitle>

<div class="app-page">
    <h1>Server</h1>

    @if (loading_)
    {
        <p>Loading…</p>
    }
    else if (status_ is null)
    {
        <p>Unable to load server status.</p>
    }
    else
    {
        <section class="card-grid">
            <article class="card">
                <div class="label">Status</div>
                <div class="value">@(restarting_ ? "Restarting…" : status_.Online ? "Online" : "Offline")</div>
            </article>
            <article class="card">
                <div class="label">Players</div>
                <div class="value">@status_.PlayerCount</div>
            </article>
        </section>

        @if (!restarting_ && !string.IsNullOrWhiteSpace(status_.Error))
        {
            <div class="error">@status_.Error</div>
        }

        <section class="panel">
            <h2>Players</h2>
            @if (status_.Players.Count == 0)
            {
                <p>No players online.</p>
            }
            else
            {
                <ul>
                    @foreach (var player in status_.Players)
                    {
                        <li>@player</li>
                    }
                </ul>
            }
        </section>
    }

    <div class="actions">
        <button @onclick="RefreshAsync" disabled="@(loading_ || restarting_)">Refresh</button>
        <button class="danger" @onclick="RestartAsync" disabled="@(!CanRestart)">
            @if (restarting_)
            {
                <span class="spinner" aria-hidden="true"></span>
                <span>Restarting…</span>
            }
            else
            {
                <span>Restart</span>
            }
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(message_))
    {
        <p class="restart-message">
            @if (restarting_)
            {
                <span class="spinner" aria-hidden="true"></span>
            }
            <span>@message_</span>
        </p>
    }
</div>

@code {
    private static readonly TimeSpan RestartTimeout = TimeSpan.FromSeconds(90);
    private static readonly TimeSpan RestartPollInterval = TimeSpan.FromSeconds(2);

    private MinecraftStatus? status_;
    private bool loading_ = true;
    private bool restarting_;
    private string? message_;
    private bool CanRestart => status_?.Online == true && !restarting_;

    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task RefreshAsync()
    {
        loading_ = true;
        message_ = null;
        status_ = await Minecraft.GetStatusAsync();
        loading_ = false;
    }

    private async Task RestartAsync()
    {
        if (!CanRestart)
            return;

        restarting_ = true;
        message_ = "Sending restart command…";

        try
        {
            await Minecraft.RestartAsync();
            message_ = "Waiting for the server to come back online…";

            var deadline = DateTimeOffset.UtcNow + RestartTimeout;
            var observedOffline = false;

            while (DateTimeOffset.UtcNow < deadline)
            {
                await Task.Delay(RestartPollInterval);

                var polledStatus = await Minecraft.GetStatusAsync();
                status_ = polledStatus;

                if (!polledStatus.Online)
                {
                    observedOffline = true;
                    await InvokeAsync(StateHasChanged);
                    continue;
                }

                // Normally we observe the RCON outage first. If the restart is quick enough
                // to occur between polls, an online response still confirms the server is available.
                if (observedOffline || DateTimeOffset.UtcNow >= deadline - RestartTimeout + TimeSpan.FromSeconds(6))
                {
                    message_ = "Server is back online.";
                    return;
                }
            }

            status_ = await Minecraft.GetStatusAsync();
            if (status_.Online)
                message_ = "Server is online, but the restart transition could not be confirmed.";
            else
                message_ = $"Server did not come back online within {RestartTimeout.TotalSeconds:0} seconds and is currently offline.";
        }
        catch (Exception ex)
        {
            status_ = await Minecraft.GetStatusAsync();
            message_ = ex.Message;
        }
        finally
        {
            restarting_ = false;
        }
    }
}
