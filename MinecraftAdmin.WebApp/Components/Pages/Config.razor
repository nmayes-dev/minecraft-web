@page "/config"
@rendermode InteractiveServer
@inject ConfigurationService Configuration

<PageTitle>Configuration</PageTitle>

<h1>Configuration</h1>

@if (loadingFiles_)
{
    <p>Loading configuration files…</p>
}
else if (!string.IsNullOrWhiteSpace(error_))
{
    <p class="error">@error_</p>
}
else
{
    <div class="config-layout">
        <aside class="config-browser panel">
            <div class="config-browser-header">
                <strong>Configuration files</strong>
                <button type="button" @onclick="RefreshAsync" disabled="@loadingDocument_">Refresh</button>
            </div>

            @foreach (var group in files_.GroupBy(x => x.Group))
            {
                <div class="config-group">
                    <div class="config-group-title">@group.Key</div>
                    @foreach (var file in group)
                    {
                        <button type="button"
                                class="config-file @(document_?.Path == file.Path ? "selected" : null)"
                                title="@file.Path"
                                @onclick="() => OpenAsync(file.Path)">
                            <span>@file.Name</span>
                            <small>@GetDisplayPath(file)</small>
                        </button>
                    }
                </div>
            }

            @if (files_.Count == 0)
            {
                <p class="muted">No supported configuration files were found.</p>
            }
        </aside>

        <section class="config-editor panel">
            @if (loadingDocument_)
            {
                <p>Loading configuration…</p>
            }
            else if (document_ is null)
            {
                <div class="config-empty">
                    <h2>Select a configuration file</h2>
                    <p>Choose a file from the navigator to edit its supported values.</p>
                </div>
            }
            else
            {
                <div class="config-editor-header">
                    <div>
                        <h2>@document_.Name</h2>
                        <div class="config-path">@document_.Path · @document_.Format</div>
                    </div>
                    <button type="button" @onclick="SaveAsync" disabled="@saving_">@(saving_ ? "Saving…" : "Save")</button>
                </div>

                @if (document_.Fields.Count == 0)
                {
                    <p class="muted">This file does not contain any scalar values that the dynamic editor currently supports.</p>
                }
                else
                {
                    @foreach (var section in document_.Fields.GroupBy(x => x.Section ?? string.Empty))
                    {
                        <div class="config-section">
                            @if (!string.IsNullOrWhiteSpace(section.Key))
                            {
                                <h3>@section.Key</h3>
                            }

                            <div class="config-fields">
                                @foreach (var field in section)
                                {
                                    <div class="config-field">
                                        <div class="config-field-label">
                                            <label for="@FieldElementId(field)">@field.Key</label>
                                            @if (!string.IsNullOrWhiteSpace(field.Description))
                                            {
                                                <small>@field.Description</small>
                                            }
                                        </div>

                                        @if (field.Kind == ConfigValueKind.Boolean)
                                        {
                                            <label class="config-switch">
                                                <input id="@FieldElementId(field)"
                                                       type="checkbox"
                                                       checked="@IsChecked(field)"
                                                       @onchange="e => SetBoolean(field, e.Value)" />
                                                <span>@(IsChecked(field) ? "Enabled" : "Disabled")</span>
                                            </label>
                                        }
                                        else if (field.Kind == ConfigValueKind.Integer)
                                        {
                                            <input id="@FieldElementId(field)" type="number" step="1" @bind="field.Value" />
                                        }
                                        else if (field.Kind == ConfigValueKind.Decimal)
                                        {
                                            <input id="@FieldElementId(field)" type="number" step="any" @bind="field.Value" />
                                        }
                                        else
                                        {
                                            <input id="@FieldElementId(field)" type="text" @bind="field.Value" />
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }

                @if (!string.IsNullOrWhiteSpace(message_))
                {
                    <p class="@(saveFailed_ ? "error" : "success")">@message_</p>
                }
            }
        </section>
    </div>
}

@code {
    private IReadOnlyList<ConfigFileInfo> files_ = [];
    private ConfigDocument? document_;
    private bool loadingFiles_ = true;
    private bool loadingDocument_;
    private bool saving_;
    private bool saveFailed_;
    private string? error_;
    private string? message_;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        loadingFiles_ = true;
        error_ = null;
        try
        {
            var selectedPath = document_?.Path;
            files_ = await Configuration.GetFilesAsync();

            if (selectedPath is not null && files_.Any(x => x.Path == selectedPath))
                await OpenAsync(selectedPath);
            else if (document_ is null && files_.Count > 0)
                await OpenAsync(files_[0].Path);
        }
        catch (Exception ex)
        {
            error_ = ex.Message;
        }
        finally
        {
            loadingFiles_ = false;
        }
    }

    private async Task OpenAsync(string path)
    {
        loadingDocument_ = true;
        message_ = null;
        saveFailed_ = false;
        try
        {
            document_ = await Configuration.GetAsync(path);
        }
        catch (Exception ex)
        {
            document_ = null;
            message_ = ex.Message;
            saveFailed_ = true;
        }
        finally
        {
            loadingDocument_ = false;
        }
    }

    private async Task SaveAsync()
    {
        if (document_ is null)
            return;

        saving_ = true;
        message_ = null;
        saveFailed_ = false;
        try
        {
            await Configuration.UpdateAsync(document_.Path, document_.Fields);
            document_ = await Configuration.GetAsync(document_.Path);
            message_ = "Saved. Some configuration changes require a Minecraft restart before they take effect.";
        }
        catch (Exception ex)
        {
            message_ = ex.Message;
            saveFailed_ = true;
        }
        finally
        {
            saving_ = false;
        }
    }

    private static string GetDisplayPath(ConfigFileInfo file)
    {
        var slash = file.Path.LastIndexOf('/');
        return slash < 0 ? file.Format : $"{file.Path[..slash]} · {file.Format}";
    }

    private static string FieldElementId(ConfigField field) => "config-" + field.Id
        .Replace('.', '-')
        .Replace('[', '-')
        .Replace(']', '-')
        .Replace(':', '-');

    private static bool IsChecked(ConfigField field) => bool.TryParse(field.Value, out var value) && value;

    private static void SetBoolean(ConfigField field, object? value)
    {
        field.Value = value switch
        {
            bool boolean => boolean.ToString().ToLowerInvariant(),
            string text when bool.TryParse(text, out var boolean) => boolean.ToString().ToLowerInvariant(),
            _ => "false"
        };
    }
}
