@page "/config"
@rendermode InteractiveServer
@inject ConfigurationService Configuration

<PageTitle>Configuration</PageTitle>

<div class="app-page config-page">
    <h1>Configuration</h1>

    @if (loadingFiles_)
    {
        <p>Loading configuration files…</p>
    }
    else if (!string.IsNullOrWhiteSpace(error_))
    {
        <p class="error">@error_</p>
    }
    else
    {
        <div class="config-layout">
            <aside class="config-browser panel">
                <div class="config-browser-header">
                    <strong>Configuration Files</strong>
                    <button type="button"
                            class="icon-button"
                            title="Refresh configuration files"
                            aria-label="Refresh configuration files"
                            @onclick="RefreshAsync"
                            disabled="@loadingDocument_">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M20 6v5h-5M4 18v-5h5M18.4 9A7 7 0 0 0 6.2 6.2L4 8m16 8-2.2 1.8A7 7 0 0 1 5.6 15" />
                        </svg>
                    </button>
                </div>

                <div class="config-search">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="11" cy="11" r="7" />
                        <path d="m16 16 5 5" />
                    </svg>
                    <input type="search"
                           value="@searchText_"
                           @oninput="OnSearchChanged"
                           placeholder="Search configs…"
                           aria-label="Search configuration files" />
                    @if (!string.IsNullOrWhiteSpace(searchText_))
                    {
                        <button type="button"
                                class="config-search-clear"
                                title="Clear search"
                                aria-label="Clear search"
                                @onclick="ClearSearch">
                            ×
                        </button>
                    }
                </div>

                <div class="config-list">
                    @foreach (var group in VisibleGroups)
                    {
                        var expanded = ShouldShowGroupContents(group.Key);
                        <div class="config-group">
                            <button type="button"
                                    class="config-group-title"
                                    aria-expanded="@expanded"
                                    @onclick="() => ToggleGroup(group.Key)">
                                <span class="config-group-chevron @(expanded ? "expanded" : null)">▶</span>
                                <span>@group.Key</span>
                                <span class="config-group-count">@group.Count()</span>
                            </button>

                            @if (expanded)
                            {
                                <div class="config-group-files">
                                    <ConfigTree Nodes="BuildTree(group)"
                                                SelectedPath="document_?.Path"
                                                OnFileSelected="OpenAsync"
                                                CollapsedFolders="collapsedFolders_"
                                                SearchActive="@IsSearching" />
                                </div>
                            }
                        </div>
                    }

                    @if (files_.Count == 0)
                    {
                        <p class="muted">No supported configuration files were found.</p>
                    }
                    else if (!FilteredFiles.Any())
                    {
                        <p class="muted config-search-empty">No configuration files match your search.</p>
                    }
                </div>
            </aside>

            <section class="config-editor panel">
                @if (loadingDocument_)
                {
                    <p>Loading configuration…</p>
                }
                else if (document_ is null)
                {
                    <div class="config-empty">
                        <h2>Select a configuration file</h2>
                        <p>Choose a file from the navigator to edit its supported values.</p>
                    </div>
                }
                else
                {
                    <div class="config-editor-header">
                        <div>
                            <h2>@document_.Name</h2>
                            <div class="config-path">@document_.Path · @document_.Format</div>
                        </div>
                        <button type="button" @onclick="SaveAsync" disabled="@saving_">@(saving_ ? "Saving…" : "Save")</button>
                    </div>

                    @if (document_.Fields.Count == 0)
                    {
                        <p class="muted">This file does not contain any scalar values that the dynamic editor currently supports.</p>
                    }
                    else
                    {
                        @foreach (var section in document_.Fields.GroupBy(x => x.Section ?? string.Empty))
                        {
                            <div class="config-section">
                                @if (!string.IsNullOrWhiteSpace(section.Key))
                                {
                                    <h3>@section.Key</h3>
                                }

                                <div class="config-fields">
                                    @foreach (var field in section)
                                    {
                                        <div class="config-field">
                                            <div class="config-field-label">
                                                <label for="@FieldElementId(field)">@field.Key</label>
                                                @if (!string.IsNullOrWhiteSpace(field.Description))
                                                {
                                                    <small>@field.Description</small>
                                                }
                                            </div>

                                            @if (field.Kind == ConfigValueKind.Boolean)
                                            {
                                                <label class="config-switch">
                                                    <input id="@FieldElementId(field)"
                                                           type="checkbox"
                                                           checked="@IsChecked(field)"
                                                           @onchange="e => SetBoolean(field, e.Value)" />
                                                    <span>@(IsChecked(field) ? "Enabled" : "Disabled")</span>
                                                </label>
                                            }
                                            else if (field.Kind == ConfigValueKind.Integer)
                                            {
                                                <input id="@FieldElementId(field)" type="number" step="1" @bind="field.Value" />
                                            }
                                            else if (field.Kind == ConfigValueKind.Decimal)
                                            {
                                                <input id="@FieldElementId(field)" type="number" step="any" @bind="field.Value" />
                                            }
                                            else
                                            {
                                                <input id="@FieldElementId(field)" type="text" @bind="field.Value" />
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }

                    @if (!string.IsNullOrWhiteSpace(message_))
                    {
                        <p class="@(saveFailed_ ? "error" : "success")">@message_</p>
                    }
                }
            </section>
        </div>
    }
</div>

@code {
    private IReadOnlyList<ConfigFileInfo> files_ = [];
    private readonly Dictionary<string, bool> collapsedGroups_ = new(StringComparer.Ordinal);
    private readonly HashSet<string> collapsedFolders_ = new(StringComparer.OrdinalIgnoreCase);
    private ConfigDocument? document_;
    private bool loadingFiles_ = true;
    private bool loadingDocument_;
    private bool saving_;
    private bool saveFailed_;
    private string searchText_ = string.Empty;
    private string? error_;
    private string? message_;

    private bool IsSearching => !string.IsNullOrWhiteSpace(searchText_);

    private IEnumerable<ConfigFileInfo> FilteredFiles
    {
        get
        {
            var terms = searchText_
                .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

            if (terms.Length == 0)
                return files_;

            return files_.Where(file =>
            {
                var searchable = string.IsNullOrWhiteSpace(file.SearchText)
                    ? $"{file.Name} {file.Path}"
                    : file.SearchText;

                return terms.All(term => searchable.Contains(term, StringComparison.OrdinalIgnoreCase));
            });
        }
    }

    private IEnumerable<IGrouping<string, ConfigFileInfo>> VisibleGroups => FilteredFiles.GroupBy(file => file.Group);

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        loadingFiles_ = true;
        error_ = null;
        try
        {
            var selectedPath = document_?.Path;
            files_ = await Configuration.GetFilesAsync();

            if (selectedPath is not null && files_.Any(x => x.Path == selectedPath))
                await OpenAsync(selectedPath);
            else if (document_ is null && files_.Count > 0)
                await OpenAsync(files_[0].Path);
        }
        catch (Exception ex)
        {
            error_ = ex.Message;
        }
        finally
        {
            loadingFiles_ = false;
        }
    }

    private async Task OpenAsync(string path)
    {
        loadingDocument_ = true;
        message_ = null;
        saveFailed_ = false;
        try
        {
            document_ = await Configuration.GetAsync(path);
        }
        catch (Exception ex)
        {
            document_ = null;
            message_ = ex.Message;
            saveFailed_ = true;
        }
        finally
        {
            loadingDocument_ = false;
        }
    }

    private async Task SaveAsync()
    {
        if (document_ is null)
            return;

        saving_ = true;
        message_ = null;
        saveFailed_ = false;
        try
        {
            await Configuration.UpdateAsync(document_.Path, document_.Fields);
            document_ = await Configuration.GetAsync(document_.Path);
            message_ = "Saved. Some configuration changes require a server restart before they take effect.";
        }
        catch (Exception ex)
        {
            message_ = ex.Message;
            saveFailed_ = true;
        }
        finally
        {
            saving_ = false;
        }
    }

    private void OnSearchChanged(ChangeEventArgs args) => searchText_ = args.Value?.ToString() ?? string.Empty;

    private void ClearSearch() => searchText_ = string.Empty;

    private void ToggleGroup(string group) => collapsedGroups_[group] = !IsCollapsed(group);

    private bool IsCollapsed(string group) =>
        collapsedGroups_.TryGetValue(group, out var collapsed) && collapsed;

    private bool ShouldShowGroupContents(string group) => IsSearching || !IsCollapsed(group);

    private static IReadOnlyList<ConfigTreeNode> BuildTree(IEnumerable<ConfigFileInfo> files)
    {
        var roots = new List<ConfigTreeNode>();

        foreach (var file in files)
        {
            var relativePath = StripGroupPrefix(file);
            var parts = relativePath.Split('/', StringSplitOptions.RemoveEmptyEntries);
            var current = roots;
            var keyParts = new List<string> { file.Group };

            for (var i = 0; i < parts.Length - 1; ++i)
            {
                var part = parts[i];
                keyParts.Add(part);
                var key = string.Join('/', keyParts);
                var directory = current.FirstOrDefault(node => node.IsDirectory && string.Equals(node.Name, part, StringComparison.OrdinalIgnoreCase));

                if (directory is null)
                {
                    directory = new ConfigTreeNode { Name = part, Key = key };
                    current.Add(directory);
                }

                current = directory.Children;
            }

            current.Add(new ConfigTreeNode
            {
                Name = file.Name,
                Key = file.Path,
                File = file
            });
        }

        SortTree(roots);
        return roots;
    }

    private static string StripGroupPrefix(ConfigFileInfo file)
    {
        var prefix = file.Group switch
        {
            "Default Configs" => "defaultconfigs/",
            "Mod Configs" => "config/",
            _ => string.Empty
        };

        return prefix.Length > 0 && file.Path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)
            ? file.Path[prefix.Length..]
            : file.Path;
    }

    private static void SortTree(List<ConfigTreeNode> nodes)
    {
        nodes.Sort((left, right) =>
        {
            if (left.IsDirectory != right.IsDirectory)
                return left.IsDirectory ? -1 : 1;
            return StringComparer.OrdinalIgnoreCase.Compare(left.Name, right.Name);
        });

        foreach (var node in nodes.Where(node => node.IsDirectory))
            SortTree(node.Children);
    }

    private static string FieldElementId(ConfigField field) => "config-" + field.Id
        .Replace('.', '-')
        .Replace('[', '-')
        .Replace(']', '-')
        .Replace(':', '-');

    private static bool IsChecked(ConfigField field) => bool.TryParse(field.Value, out var value) && value;

    private static void SetBoolean(ConfigField field, object? value)
    {
        field.Value = value switch
        {
            bool boolean => boolean.ToString().ToLowerInvariant(),
            string text when bool.TryParse(text, out var boolean) => boolean.ToString().ToLowerInvariant(),
            _ => "false"
        };
    }
}
