@page "/modpacks"
@rendermode InteractiveServer
@inject ModpackService ModpackService
@inject NavigationManager Navigation

<PageTitle>Modpacks</PageTitle>

<div class="app-page modpack-page">
    <div class="page-heading">
        <h1>Modpacks</h1>
        <p class="hint">Choose an uploaded server pack and either start a new world or restore one previously saved for that pack.</p>
    </div>

    @if (loading_)
    {
        <p>Loading…</p>
    }
    else if (library_.Modpacks.Count == 0)
    {
        <section class="panel empty-panel">
            <h2>No modpacks uploaded</h2>
            <p class="hint">Upload a server pack ZIP and its Minecraft environment settings before switching.</p>
            <button @onclick="OpenUpload">Upload modpack</button>
        </section>
    }
    else
    {
        <section class="panel modpack-panel">
            <label for="modpack">Modpack</label>

            <div class="modpack-edit">
                @{
                    bool noPack = SelectedModpack is null;
                    var selectClass = noPack ? "modpack-none" : selectedModpackId_ == library_.ActiveModpackId ? "current-pack" : null;
                    <select id="modpack" class="@selectClass" @bind="selectedModpackId_" @bind:after="OnModpackChanged" disabled="@switching_">
                        @if (noPack)
                        {
                            <option value="" class="modpack-placeholder" disabled hidden>Select a modpack...</option>
                        }
                        @foreach (var modpack in library_.Modpacks)
                        {
                            bool isCurrentPack = modpack.Id == library_.ActiveModpackId;
                            <option value="@modpack.Id" class="@(isCurrentPack ? "current-pack" : "not-current-pack")">
                                @modpack.Name
                                @if (isCurrentPack)
                                {
                                    <text> ✓</text>
                                }

                            </option>
                        }
                    </select>
                    <button class="edit-button" @onclick="OpenEdit" disabled="@(switching_ || SelectedModpack is null)">Edit</button>
                }
            </div>

            @if (SelectedModpack is { } selected)
            {
                <label for="world">World</label>
                <select id="world" @bind="selectedWorldId_" disabled="@switching_">
                    <option value="">Create a new world</option>
                    @foreach (var world in selected.Worlds.OrderByDescending(world => world.CreatedAtUtc))
                    {
                        <option value="@world.Id">
                            Restore @world.CreatedAtUtc.ToLocalTime().ToString("g") (@FormatBytes(world.SizeBytes))
                        </option>
                    }
                </select>
            }
            @if (!confirming_)
            {
                <div class="switch-details">
                    <button @onclick="OpenUpload" disabled="@switching_">Upload</button>
                    <button class="danger change-button" @onclick="BeginConfirmation" disabled="@(switching_ || SelectedModpack is null)">
                        Switch
                    </button>
                    @if (!string.IsNullOrWhiteSpace(progressMessage_))
                    {
                        <p class="status-message">
                            @if (switching_)
                            {
                                <span class="spinner" aria-hidden="true"></span>
                            }
                            <span>@progressMessage_</span>
                        </p>
                    }
                </div>
            }
            else
            {
                <div class="confirmation">
                    <strong>Are you sure?</strong>
                    <span>@ConfirmationText</span>
                    <div class="confirmation-actions">
                        <button class="danger" @onclick="SwitchAsync" disabled="@switching_">Confirm</button>
                        <button @onclick="CancelConfirmation" disabled="@switching_">Cancel</button>
                    </div>
                </div>
            }
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(error_))
    {
        <div class="error">@error_</div>
    }
</div>

@code {
    private bool loading_ = true;
    private bool switching_;
    private bool confirming_;
    private string selectedModpackId_ = string.Empty;
    private string selectedWorldId_ = string.Empty;
    private string? progressMessage_;
    private string? error_;
    private ModpackLibraryState library_ = new([], null);

    private ModpackDefinition? SelectedModpack =>
        library_.Modpacks.FirstOrDefault(modpack => modpack.Id == selectedModpackId_);

    private string ActiveModpackName =>
        library_.Modpacks.FirstOrDefault(modpack => modpack.Id == library_.ActiveModpackId)?.Name ?? "Unmanaged / unknown";

    private string ConfirmationText
    {
        get
        {
            if (SelectedModpack is not { } selected)
                return string.Empty;


            var world = selected.Worlds.FirstOrDefault(item => item.Id == selectedWorldId_);
            return world is null
                ? $"{selected.Name} will be installed with a new world."
                : $"{selected.Name} will be installed and its world from {world.CreatedAtUtc.ToLocalTime():g} will be restored.";
        }
    }

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        loading_ = true;
        error_ = null;

        try
        {
            library_ = await ModpackService.GetLibraryAsync();
            
            if (library_.Modpacks.Count > 0 && !library_.Modpacks.Any(modpack => modpack.Id == selectedModpackId_))
                selectedModpackId_ = library_.ActiveModpackId ?? string.Empty;

            selectedWorldId_ = string.Empty;
        }
        catch (Exception ex)
        {
            error_ = ex.Message;
        }
        finally
        {
            loading_ = false;
        }
    }

    private void OnModpackChanged()
    {
        selectedWorldId_ = string.Empty;
        confirming_ = false;
        error_ = null;
        progressMessage_ = null;
    }

    private void OpenUpload() => Navigation.NavigateTo("/modpacks/upload");

    private void OpenEdit()
    {
        if (SelectedModpack is { } selected)
            Navigation.NavigateTo($"/modpacks/{Uri.EscapeDataString(selected.Id)}/edit");
    }

    private void BeginConfirmation()
    {
        error_ = null;
        progressMessage_ = null;
        confirming_ = true;
    }

    private void CancelConfirmation() => confirming_ = false;

    private async Task SwitchAsync()
    {
        if (switching_ || SelectedModpack is null)
            return;

        switching_ = true;
        confirming_ = false;
        error_ = null;
        progressMessage_ = "Starting modpack change…";

        var progress = new Progress<string>(message =>
        {
            progressMessage_ = message;
            _ = InvokeAsync(StateHasChanged);
        });

        try
        {
            var result = await ModpackService.SwitchAsync(
                new ModpackSwitchRequest(
                    selectedModpackId_,
                    string.IsNullOrWhiteSpace(selectedWorldId_) ? null : selectedWorldId_),
                progress);

            await ReloadAsync();
            progressMessage_ = $"{result.Message} Full backup: {Path.GetFileName(result.BackupArchiveFile)}";
        }
        catch (Exception ex)
        {
            error_ = ex.Message;
            progressMessage_ = null;
        }
        finally
        {
            switching_ = false;
        }
    }

    private static string FormatBytes(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        var value = (double)bytes;
        var unit = 0;
        while (value >= 1024 && unit < units.Length - 1)
        {
            value /= 1024;
            unit++;
        }
        return $"{value:0.##} {units[unit]}";
    }
}
